{
  "name": "mqtracker",
  "displayName": "MQTracker",
  "description": "RabbitMQ inspector and message tracing tool",
  "version": "1.0.0",
  "publisher": "alekkk31",
  "license": "ISC",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mqtracker-sidebar",
          "title": "MQTracker",
          "icon": "media/rabbit.svg"
        }
      ]
    },
    "views": {
      "mqtracker-sidebar": [
        {
          "id": "mqtracker.connections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "mqtracker.addConnection",
        "title": "Add Connection",
        "icon": "$(add)",
        "category": "MQTracker"
      },
      {
        "command": "mqtracker.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "MQTracker"
      },
      {
        "command": "mqtracker.removeConnection",
        "title": "Remove Connection",
        "icon": "$(trash)",
        "category": "MQTracker"
      },
      {
        "command": "mqtracker.openMessageViewer",
        "title": "Open Message Viewer",
        "icon": "$(eye)",
        "category": "MQTracker"
      },
      {
        "command": "mqtracker.publishMessage",
        "title": "Publish Message",
        "icon": "$(send)",
        "category": "MQTracker"
      },
      {
        "command": "mqtracker.openConsumerInCode",
        "title": "Find Consumer in Code",
        "icon": "$(search)",
        "category": "MQTracker"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mqtracker.addConnection",
          "when": "view == mqtracker.connections",
          "group": "navigation"
        },
        {
          "command": "mqtracker.refresh",
          "when": "view == mqtracker.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mqtracker.removeConnection",
          "when": "view == mqtracker.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "mqtracker.openMessageViewer",
          "when": "view == mqtracker.connections && viewItem == queue",
          "group": "inline"
        },
        {
          "command": "mqtracker.publishMessage",
          "when": "view == mqtracker.connections && viewItem == connection",
          "group": "1_actions"
        },
        {
          "command": "mqtracker.openConsumerInCode",
          "when": "view == mqtracker.connections && viewItem == queue",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:prod": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AleKK31/MQTracker.git"
  },
  "bugs": {
    "url": "https://github.com/AleKK31/MQTracker/issues"
  },
  "homepage": "https://github.com/AleKK31/MQTracker#readme",
  "type": "commonjs",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^30.0.0",
    "@types/nock": "^10.0.3",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.118.0",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "nock": "^14.0.14",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "amqplib": "^1.0.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.1"
  }
}
